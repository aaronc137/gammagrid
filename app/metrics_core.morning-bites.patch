+def _provider_gamma_or(frame: pd.DataFrame, modelled) -> pd.Series:
+    """morning-bites patch (2026-10-08, option "b"): the provider's own gamma where it served one, Black-Scholes
+    only where it did not.
+
+    Cboe's greeks come from its full model (American exercise, dividends) and are the same numbers morning-bites'
+    own edition, levels_review and dix_calib read, so the two products agree on the sign. Measured on the 2026-10-08
+    premarket chains: Black-Scholes from the quoted IV sits systematically on both sides of the vendor's gamma
+    (OI-weighted Cboe/BS — SPY calls 1.22 / puts 0.89, QQQ 1.09 / 0.86, SPX 0.93 / 1.07), enough to flip the net
+    sign on SPY and QQQ. A chain without a provider gamma column (upstream fixtures, other providers) is unchanged.
+
+    `modelled` is the Black-Scholes gamma aligned row-for-row with `frame`; it stands wherever the provider column
+    is absent or NaN. A provider gamma of exactly 0 is kept — deep in or out of the money that is the honest value.
+    """
+    modelled = pd.Series(np.asarray(modelled, dtype=float), index=frame.index)
+    if "gamma" not in frame.columns:
+        return modelled
+    provided = pd.to_numeric(frame["gamma"], errors="coerce")
+    return provided.where(provided.notna(), modelled)
 
 
